{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos base de la app de escritorio CoreNetwork.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://corenetwork.lovable.app", "http://localhost:8080"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "shell:allow-open"
  ]
}
